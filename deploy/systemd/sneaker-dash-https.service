[Unit]
Description=Sneaker Impact Dash — HTTPS (port 8443, station camera capture)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=@DASH_DIR@
# Unbuffered stdout so [worker]/[outbox] prints reach journald immediately
# (block-buffered prints made the worker look dead during long jobs).
Environment=PYTHONUNBUFFERED=1
ExecStart=@DASH_DIR@/venv/bin/uvicorn backend.main:app --host 0.0.0.0 --port 8443 --ssl-keyfile certs/dash-key.pem --ssl-certfile certs/dash-cert.pem
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
