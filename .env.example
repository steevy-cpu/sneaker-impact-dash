# Copy this file to .env and adjust values before running.
# .env is gitignored — never commit it.

# "simulation" seeds fake data on startup (default for demo/development).
# "actual" connects to a real inspection station.
APP_MODE=simulation

# Number of fake records seeded when the database is empty (simulation mode only).
SEED_COUNT=50

# AI model version tag stored on every inspection record.
MODEL_VERSION=v1.0-sim

# --- Airtable: barcode → shipment lookup + outbound 2-stage sync ---
# Leave BLANK to keep everything dormant (lookup returns "not configured"; no
# writes). Fill BOTH keys, then restart the server, and it auto-activates:
#   • barcode → shipment preview on the Capture page
#   • Stage 1: box metadata written to "Shipments Received" on capture
#   • Stage 2: brand summary written there when processing completes
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
# Optional overrides (defaults shown):
# AIRTABLE_SHIPMENTS_TABLE=Shipments Received
# AIRTABLE_PARTNERS_TABLE=Partners
# AIRTABLE_SYNC_ENABLED=1            # set 0 to keep lookups but disable writes
# SHIPMENT_LOOKUP_SOURCES=airtable   # e.g. "fedex,airtable" once FedEx is wired
